[
  {
    "id": "users_col",
    "name": "users",
    "type": "auth",
    "fields": [
      {"system": true, "name": "id", "type": "text"},
      {"system": true, "name": "email", "type": "email"},
      {"system": true, "name": "password", "type": "password"},
      {"system": true, "name": "passwordConfirm", "type": "password"},
      {"system": true, "name": "verified", "type": "bool"},
      {"system": true, "name": "created", "type": "date"},
      {"system": true, "name": "updated", "type": "date"},
      {"name": "avatar", "type": "file", "options": {"maxSelect": 1, "maxSize": 2097152, "mimeTypes": ["image/jpeg","image/png","image/webp"]}},
      {"name": "subscription_plan", "type": "select", "options": {"maxSelect": 1, "values": ["free","pro","team"], "required": true}},
      {"name": "tokens_balance", "type": "number", "options": {"min": 0}}
    ],
    "listRule": "@request.auth.id != ''",
    "viewRule": "@request.auth.id != ''",
    "createRule": "@request.auth.id = ''",
    "updateRule": "@request.auth.id = @col.id",
    "deleteRule": "@request.auth.id = @col.id"
  },
  {
    "id": "projects_col",
    "name": "projects",
    "type": "base",
    "fields": [
      {"system": true, "name": "id", "type": "text"},
      {"system": true, "name": "created", "type": "date"},
      {"system": true, "name": "updated", "type": "date"},
      {"name": "name", "type": "text", "options": {"min": 1, "max": 200}},
      {"name": "path", "type": "text", "options": {"min": 1}},
      {"name": "project_type", "type": "select", "options": {"maxSelect": 1, "values": ["flutter_app","flutter_package","react","node","python","vscode_extension","blogger","n8n_workflow","other"]}},
      {"name": "tech_stack", "type": "json"},
      {"name": "health_score", "type": "number", "options": {"min": 0, "max": 100}},
      {"name": "owner", "type": "relation", "options": {"collectionId": "users_col", "cascadeDelete": true, "maxSelect": 1}}
    ],
    "listRule": "@request.auth.id != '' && owner = @request.auth.id",
    "viewRule": "@request.auth.id != '' && owner = @request.auth.id",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.id != '' && owner = @request.auth.id",
    "deleteRule": "@request.auth.id != '' && owner = @request.auth.id"
  },
  {
    "id": "patterns_col",
    "name": "patterns",
    "type": "base",
    "fields": [
      {"system": true, "name": "id", "type": "text"},
      {"system": true, "name": "created", "type": "date"},
      {"system": true, "name": "updated", "type": "date"},
      {"name": "name", "type": "text", "options": {"min": 1, "max": 200}},
      {"name": "content", "type": "editor", "options": {"type": "rich_text"}},
      {"name": "tags", "type": "select", "options": {"maxSelect": 0, "values": ["flutter","react","python","node","config","docs","ci","testing","styling","animation","voice","music","animation","publishing"]}},
      {"name": "is_public", "type": "bool"},
      {"name": "owner", "type": "relation", "options": {"collectionId": "users_col", "cascadeDelete": true, "maxSelect": 1}},
      {"name": "project", "type": "relation", "options": {"collectionId": "projects_col", "cascadeDelete": false, "maxSelect": 1}}
    ],
    "listRule": "@request.auth.id != '' && (is_public = true || owner = @request.auth.id)",
    "viewRule": "@request.auth.id != '' && (is_public = true || owner = @request.auth.id)",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.id != '' && owner = @request.auth.id",
    "deleteRule": "@request.auth.id != '' && owner = @request.auth.id"
  },
  {
    "id": "agent_runs_col",
    "name": "agent_runs",
    "type": "base",
    "fields": [
      {"system": true, "name": "id", "type": "text"},
      {"system": true, "name": "created", "type": "date"},
      {"system": true, "name": "updated", "type": "date"},
      {"name": "agent_type", "type": "select", "options": {"maxSelect": 1, "values": ["analyzer","classifier","version_checker","orchestrator"]}},
      {"name": "status", "type": "select", "options": {"maxSelect": 1, "values": ["running","completed","failed"]}},
      {"name": "tokens_used", "type": "number"},
      {"name": "output", "type": "text"},
      {"name": "owner", "type": "relation", "options": {"collectionId": "users_col", "cascadeDelete": true, "maxSelect": 1}},
      {"name": "project", "type": "relation", "options": {"collectionId": "projects_col", "cascadeDelete": true, "maxSelect": 1}}
    ],
    "listRule": "@request.auth.id != '' && owner = @request.auth.id",
    "viewRule": "@request.auth.id != '' && owner = @request.auth.id",
    "createRule": "@request.auth.id != ''",
    "updateRule": "@request.auth.id != '' && owner = @request.auth.id",
    "deleteRule": "@request.auth.id != '' && owner = @request.auth.id"
  }
]
